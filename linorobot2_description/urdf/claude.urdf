<?xml version="1.0"?>
<robot name="dome" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Parameters -->
  <xacro:property name="plate_diameter" value="0.29"/>
  <xacro:property name="plate_separation" value="0.10"/>
  <xacro:property name="plate_thickness" value="0.005"/>
  
  <xacro:property name="wheel_diameter" value="0.07"/>
  <xacro:property name="wheel_width" value="0.02"/>
  <xacro:property name="wheel_separation" value="0.20"/>
  
  <xacro:property name="caster_diameter" value="0.03"/>
  <xacro:property name="caster_offset_x" value="0.10"/>
  
  <!-- Material definitions -->
  <material name="clear_plastic">
    <color rgba="0.8 0.8 0.8 0.3"/>
  </material>
  
  <material name="black_rubber">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  
  <material name="metal">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <!-- Macros -->
  <xacro:macro name="cylinder_inertia" params="mass radius height">
    <inertia ixx="${mass * (3*radius*radius + height*height) / 12}" 
             iyy="${mass * (3*radius*radius + height*height) / 12}"
             izz="${mass * radius*radius / 2}" 
             ixy="0" ixz="0" iyz="0"/>
  </xacro:macro>

  <xacro:macro name="wheel_link" params="prefix reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <geometry>
          <cylinder radius="${wheel_diameter/2}" length="${wheel_width}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <material name="black_rubber"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_diameter/2}" length="${wheel_width}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <xacro:cylinder_inertia mass="0.2" radius="${wheel_diameter/2}" height="${wheel_width}"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${reflect * wheel_separation/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Base link (coordinate frame reference) -->
  <link name="base_link"/>

  <!-- Chassis (lower plate) -->
  <link name="chassis_link">
    <visual>
      <geometry>
        <cylinder radius="${plate_diameter/2}" length="${plate_thickness}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="clear_plastic"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${plate_diameter/2}" length="${plate_thickness}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:cylinder_inertia mass="1.0" radius="${plate_diameter/2}" height="${plate_thickness}"/>
    </inertial>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0 0 ${wheel_diameter/2}" rpy="0 0 0"/>
  </joint>

  <!-- Upper plate -->
  <link name="upper_plate_link">
    <visual>
      <geometry>
        <cylinder radius="${plate_diameter/2}" length="${plate_thickness}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="clear_plastic"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${plate_diameter/2}" length="${plate_thickness}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:cylinder_inertia mass="0.5" radius="${plate_diameter/2}" height="${plate_thickness}"/>
    </inertial>
  </link>

  <joint name="upper_plate_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="upper_plate_link"/>
    <origin xyz="0 0 ${plate_separation}" rpy="0 0 0"/>
  </joint>

  <!-- Wheels -->
  <xacro:wheel_link prefix="left" reflect="1"/>
  <xacro:wheel_link prefix="right" reflect="-1"/>

  <!-- Caster wheel -->
  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_diameter/2}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="metal"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_diameter/2}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="${2*0.1*caster_diameter*caster_diameter/25}" 
               iyy="${2*0.1*caster_diameter*caster_diameter/25}" 
               izz="${2*0.1*caster_diameter*caster_diameter/25}" 
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_offset_x} 0 ${-wheel_diameter/2 + caster_diameter/2}" rpy="0 0 0"/>
  </joint>

</robot>